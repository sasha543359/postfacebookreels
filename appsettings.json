// ЭТО ЕДИНСТВЕННЫЙ ФАЙЛ, КОТОРЫЙ НАДО НАСТРОИТЬ.
//
// Комментарии «//» здесь разрешены: .NET читает конфигурацию через
// System.Text.Json с включённым пропуском комментариев. Их можно оставить,
// они ни на что не влияют.
//
// ГЛАВНОЕ ПРО ЭТОТ ФАЙЛ: он вшивается в образ на сборке. Поэтому после ЛЮБОЙ
// правки нужен «docker compose up -d --build». Просто «up -d» поднимет старый
// образ со старыми настройками.
//
// Проверить настройки, ничего не публикуя (build обязателен — без него
// проверятся старые настройки, вшитые в образ):
//     docker compose build && docker compose run --rm app --check
{
  // ───────────────────────────────────────────────────────────────────────────
  // Страницы Facebook. Один блок = одна Страница, куда публикуем.
  //
  // Именно СТРАНИЦА, а не личный профиль: Reels API умеет публиковать только на
  // Страницы. Это ограничение Facebook, обойти его нечем.
  //
  // Обход идёт «каруселью»: берётся первый ник из каждого списка
  // TikTokUsernames, потом второй, и так далее. Поэтому списки лучше держать
  // примерно равной длины.
  // ───────────────────────────────────────────────────────────────────────────
  "FacebookPages": [
    {
      // Только для логов и для счётчика анти-спама. Любое понятное имя.
      "PageName": "Page1",

      // Числовой ID Страницы. Где взять: Graph API Explorer → GET /me/accounts
      // (см. README, раздел «Как получить токен»).
      "PageId": "ВСТАВЬ_PAGE_ID",

      // Маркер доступа СТРАНИЦЫ (Page Access Token), а не пользователя.
      // Программа проверяет это при запуске с --check и прямо скажет, если
      // вставлен не тот.
      //
      // ВАЖНО: у Страницы, которой сейчас не пользуешься, ставь "" (пустую
      // строку). Заглушка вроде "ВСТАВЬ_ТОКЕН" НЕ пустая — программа сочтёт её
      // рабочей, полезет публиковать и будет сыпать ошибками.
      "PageAccessToken": "ВСТАВЬ_PAGE_ACCESS_TOKEN",

      // Профиль уникализатора: "acc1".."acc10". Даёт этой Странице свою
      // стабильную сигнатуру (кроп, цвет, скорость, звук). Один и тот же
      // исходник на разных Страницах превращается в разные файлы.
      // Пусто — берётся PageName.
      "UniquifierProfile": "acc1",

      // Описание под Reels. Пусто — берётся описание исходного ролика TikTok.
      // Подпись «Twitch: MELLSTROY» сюда вписывать НЕ НАДО: она добавляется
      // автоматически ко всем публикациям (см. RequiredCaptionSuffix ниже).
      "CustomCaption": "",

      // Обложка Reels: ТОЛЬКО имя файла, который лежит в /var/www/videos/covers/
      // на сервере (например "cover.jpg"). Не путь. Регистр важен.
      // Пусто — Facebook сам возьмёт кадр из видео.
      //
      // Учти: обложке нужны ещё два разрешения — pages_read_user_content и
      // pages_manage_engagement. Их надо и добавить в приложение, и отметить
      // в Graph API Explorer при выпуске токена (README, «Как получить токен
      // Страницы», шаг 3). Если токен уже получен без них — пройди шаги 3–5
      // заново и вставь новый PageAccessToken. Без них ролик всё равно выйдет,
      // просто с кадром из видео, а в логе будет предупреждение.
      "CoverImage": "",

      // Надпись поверх видео (рисует уникализатор; кириллица — шрифтом из
      // Uniquifier.Font). Работает только при Uniquifier.Enabled = true.
      // Пусто — без надписи.
      "OnScreenCaption": "",

      // Ники TikTok, за которыми следим. БЕЗ «@».
      // Можно писать и ссылкой, и с «@» — программа приведёт всё к одному виду
      // при старте и уберёт повторы. Регистр не важен.
      // Если TikTok отвечает «автора нет» — ник удалён или сменился, правится
      // только здесь. Проверить весь список разом (после правки этого файла
      // build обязателен, иначе проверится старый список):
      //     docker compose build && docker compose run --rm app --check
      "TikTokUsernames": [
        "shotstroy",
        "herodrun"
      ]
    },
    {
      "PageName": "Page2",
      "PageId": "",
      "PageAccessToken": "",
      "UniquifierProfile": "acc2",
      "CustomCaption": "",
      "CoverImage": "",
      // Надпись поверх видео (рисует уникализатор; кириллица — шрифтом из
      // Uniquifier.Font). Работает только при Uniquifier.Enabled = true.
      // Пусто — без надписи.
      "OnScreenCaption": "",
      "TikTokUsernames": [
        "booys121",
        "mr_shlyaps"
      ]
    }
  ],

  // ───────────────────────────────────────────────────────────────────────────
  // Строка, которая обязана быть в описании КАЖДОГО Reels.
  // Дописывается автоматически и к описанию исходного ролика, и к CustomCaption.
  // Если она уже есть в тексте — второй раз не добавляется.
  // Пусто — ничего не дописывается.
  // ───────────────────────────────────────────────────────────────────────────
  "RequiredCaptionSuffix": "Twitch: MELLSTROY",

  // Хэштеги в конце описания — только если в тексте ролика своих нет.
  // Русские, потому что аудитория русскоязычная: язык подписи и хэштегов —
  // один из сигналов, по которым Facebook решает, кому показать ролик.
  // Пусто — хэштеги не дописываются.
  "DefaultHashtags": "#мемы #приколы #юмор #рилс",

  // Через сколько минут начинать следующий полный круг по всем Страницам.
  "CheckIntervalMinutes": 5,

  // Пауза между проверками отдельных TikTok-авторов, секунды.
  // Нужна не из вежливости: без пауз TikTok на длинном списке начинает
  // подменять страницу проверкой.
  "TikTokCheckDelaySeconds": 30,

  // ───────────────────────────────────────────────────────────────────────────
  // Facebook Graph API.
  // ───────────────────────────────────────────────────────────────────────────
  "Facebook": {
    // Версия Graph API. Меняется примерно раз в квартал, старые версии живут
    // около двух лет — спешить с обновлением не нужно.
    "ApiVersion": "v26.0",

    // Сколько секунд ждать каждый из двух этапов: пока файл дойдёт до Facebook
    // (до finish) и пока Reels выйдет (после finish). Если после finish не
    // дождались, а ошибки нет — ролик считается опубликованным (повтор дал бы
    // дубль). На практике выход занимает 10–60 с.
    "ProcessingTimeoutSeconds": 300
  },

  // ───────────────────────────────────────────────────────────────────────────
  // Уникализатор: ffmpeg-обработка перед публикацией (python3 /app/uniquify.py).
  // Если ffmpeg почему-то не отработает — публикуется исходник, ничего не
  // ломается.
  // ───────────────────────────────────────────────────────────────────────────
  "Uniquifier": {
    "Enabled": true,                 // false = публиковать сырьё, без обработки
    "PythonPath": "python3",
    "ScriptPath": "/app/uniquify.py",
    "Mode": "crop",                  // "crop" — максимальная картинка
                                     // "reframe" — клип на размытом фоне
    "Audio": "keep",                 // keep | strip | replace | mix
    "Font": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "TimeoutSeconds": 180
  },

  // ───────────────────────────────────────────────────────────────────────────
  // Анти-спам. Считается ОТДЕЛЬНО по каждой Странице, окно — скользящие 24 часа
  // (так же считает сам Facebook).
  //
  // Здесь же ответ на частый вопрос «почему постов меньше, чем новых роликов»:
  // после публикации Страница молчит MinMinutesBetweenPosts минут, сколько бы
  // новых роликов за это время ни вышло.
  // ───────────────────────────────────────────────────────────────────────────
  "Publishing": {
    "MaxPostsPerPagePerDay": 5,      // 0 = без своего лимита
    "MinMinutesBetweenPosts": 3,     // 0 = без паузы между публикациями

    // Жёсткий потолок самого Facebook: 30 публикаций на Страницу за скользящие
    // 24 часа. Программа не даст его перешагнуть в любом случае. Менять не надо.
    "ApiHardLimitPer24h": 30,

    // Счётчик лежит в /var/www/videos, потому что эта папка примонтирована
    // с сервера и переживает пересборку образа. Не удаляй его.
    "CountsPath": "/var/www/videos/post_counts.json"
  },

  "TikTokMonitor": {
    // Внутри контейнера yt-dlp лежит здесь (ставится в Dockerfile и обновляется
    // при каждом старте контейнера — TikTok ломается регулярно).
    "YtDlpPath": "/usr/local/bin/yt-dlp",

    // Папка для скачанных видео. Её же отдаёт Nginx сервера.
    "DownloadPath": "/var/www/videos",

    // Файл истории «что уже публиковали». Пусто — кладётся рядом с видео,
    // то есть переживает пересборку образа.
    // Не меняй на путь внутри контейнера: потеря истории означает, что
    // программа сочтёт запуск первым и промолчит, пока у каждого автора не
    // выйдет новый ролик.
    "HistoryPath": "",

    // АВАРИЙНЫЙ РЫЧАГ. TikTok ломает скачивание регулярно, и починка обычно
    // сводится к одному новому флагу yt-dlp. Его можно вписать сюда, не трогая
    // код и не пересобирая образ из изменённых исходников.
    // Пример: "--extractor-args tiktok:api_hostname=api22-normal-c-useast2a.tiktokv.com"
    "ExtraYtDlpArgs": "",

    // Цель для --impersonate (подмена отпечатка браузера через curl-cffi),
    // например "chrome". Помогает, когда TikTok начинает отдавать капчу.
    // Пусто — без подмены.
    "Impersonate": ""
  },

  "Server": {
    // Публичный адрес сервера, по которому Facebook забирает видео ссылкой.
    // Нужен ТОЛЬКО для "UploadMode": "url" или "auto" — тогда впиши IP своего
    // сервера, например "http://203.0.113.10".
    // С "UploadMode": "bytes" (стоит по умолчанию) адрес не используется —
    // можно оставить как есть.
    "PublicUrl": "http://ВСТАВЬ_IP_СЕРВЕРА",

    "VideoPath": "/var/www/videos",
    "CoverPath": "/var/www/videos/covers",

    // Как отдавать видео Facebook:
    //   "bytes" — файлом, телом запроса. РЕКОМЕНДУЕТСЯ: проверен вживую
    //             18.09.2026, публичный адрес и Nginx не нужны;
    //   "url"   — только ссылкой (нужен рабочий публичный адрес; вживую
    //             не проверялся);
    //   "auto"  — сначала ссылкой. На файл переходит, ТОЛЬКО если Facebook
    //             сразу отказался принять ссылку. Если принял, но скачать
    //             не смог — публикация провалится и в следующем цикле снова
    //             пойдёт по ссылке.
    "UploadMode": "bytes"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
