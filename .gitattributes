* text=auto

# Эти файлы едут на Linux-сервер и в Docker. С окончаниями строк CRLF
# bash отвечает «bad interpreter: /bin/bash^M», а Docker — ошибкой разбора,
# поэтому им окончания строк закреплены явно.
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf

*.pdf binary
*.mp4 binary
*.jpg binary
*.png binary
